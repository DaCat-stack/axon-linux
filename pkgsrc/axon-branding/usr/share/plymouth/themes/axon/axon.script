# AXON — анимация загрузки (Plymouth, модуль script).
# Паруса собираются → блик → лого «дышит» синим, под ним прыгают три точки.
# Тайминги и пропорции — из макета boot-animation-v2.html (там лого 190 px).

Window.SetBackgroundTopColor(0.027, 0.035, 0.051);     # #07090d
Window.SetBackgroundBottomColor(0.027, 0.035, 0.051);

W = Window.GetWidth();
H = Window.GetHeight();
LOGO = Math.Int(H * 0.175);          # сторона лого на экране
K = LOGO / 190;                      # 1 px макета → px экрана
SRC = 512;                           # сторона исходных картинок
GLOW_PAD = 160;

# колонка: лого, отступ 42, строка индикатора 14 — по центру экрана
TOP = Math.Int((H - LOGO - 42 * K - 14 * K) / 2);
LEFT = Math.Int((W - LOGO) / 2);
ROW_Y = TOP + LOGO + 42 * K;

fun scaled(name, size) {
    img = Image(name);
    return img.Scale(size, size);
}

fun sprite(img, z) {
    s = Sprite(img);
    s.SetZ(z);
    s.SetOpacity(0);
    return s;
}

glow_size = Math.Int((SRC + 2 * GLOW_PAD) * LOGO / SRC);
glow = sprite(scaled("glow.png", glow_size), 1);
glow.SetPosition(LEFT - Math.Int(GLOW_PAD * LOGO / SRC), TOP - Math.Int(GLOW_PAD * LOGO / SRC));

blue = sprite(scaled("blue.png", LOGO), 2);
white = sprite(scaled("white.png", LOGO), 3);

for (i = 0; i < 12; i++) {
    n = "0" + i;
    if (i >= 10) n = "" + i;
    sheen[i] = scaled("sheen-" + n + ".png", LOGO);
}
sheen_sprite = sprite(sheen[0], 4);
sheen_sprite.SetPosition(LEFT, TOP, 4);

DOT = Math.Int(7 * K);
GAP = Math.Int(10 * K);
dot_img = scaled("dot.png", DOT);
dots_left = Math.Int((W - 3 * DOT - 2 * GAP) / 2);
for (i = 0; i < 3; i++) {
    dot[i] = sprite(dot_img, 5);
    dot[i].SetX(dots_left + i * (DOT + GAP));
}

fun clamp01(x) { return Math.Clamp(x, 0, 1); }
fun ease_out(p) { q = 1 - p; return 1 - q * q * q; }
fun wave(x, period) {                 # 0→1→0 за период, начиная с 0
    ph = x / period - Math.Int(x / period);
    return 0.5 - 0.5 * Math.Cos(2 * Math.Pi * ph);
}

frame = 0;
password_mode = 0;

fun refresh() {
    t = frame / 50;
    global.frame = frame + 1;

    e = ease_out(clamp01(t - 0.3));                      # синий парус: 0.3–1.3 с, снизу
    blue.SetPosition(LEFT, TOP + Math.Int(0.40 * LOGO * (1 - e)), 2);
    blue.SetOpacity(e);

    e = ease_out(clamp01(t - 0.7));                      # белый парус: 0.7–1.7 с, справа
    white.SetPosition(LEFT + Math.Int(0.35 * LOGO * (1 - e)), TOP, 3);
    white.SetOpacity(e);

    if (t >= 1.8 && t < 2.7) {                           # блик: 0.9 с, 12 кадров
        sheen_sprite.SetImage(sheen[Math.Int((t - 1.8) / 0.9 * 12)]);
        sheen_sprite.SetOpacity(1);
    } else {
        sheen_sprite.SetOpacity(0);
    }

    if (t >= 2.8) glow.SetOpacity(wave(t - 2.8, 2.6));    # «дыхание»

    rows = clamp01((t - 2.2) / 0.6);                     # точки появляются с 2.2 с
    if (password_mode) rows = 0;
    for (i = 0; i < 3; i++) {
        v = 0;
        if (t >= 0.2 * i) v = wave(t - 0.2 * i, 1.2);
        dot[i].SetY(ROW_Y + Math.Int(3.5 * K - 5 * K * v));
        dot[i].SetOpacity(rows * (0.2 + 0.8 * v));
    }
}
Plymouth.SetRefreshFunction(refresh);

# --- ввод пароля (если диск зашифрован) — на месте точек ---
FIELD_W = Math.Int(240 * K);
FIELD_H = Math.Int(34 * K);
field = Sprite(Image("field.png").Scale(FIELD_W, FIELD_H));
field.SetPosition(Math.Int((W - FIELD_W) / 2), ROW_Y - Math.Int(10 * K), 6);
field.SetOpacity(0);
bullets = Sprite();
bullets.SetZ(7);

fun display_password(prompt, count) {
    global.password_mode = 1;
    field.SetOpacity(1);
    text = "";
    for (i = 0; i < count; i++) text = text + "●";
    if (count == 0) text = "Введите пароль";
    img = Image.Text(text, 1, 1, 1, 0.85);
    bullets.SetImage(img);
    bullets.SetPosition(Math.Int((W - img.GetWidth()) / 2), ROW_Y - Math.Int(10 * K) + Math.Int((FIELD_H - img.GetHeight()) / 2), 7);
    bullets.SetOpacity(1);
}

fun display_normal() {
    global.password_mode = 0;
    field.SetOpacity(0);
    bullets.SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
