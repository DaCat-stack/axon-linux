/* AXON: тёмное окно, кнопки с градиентом бирюзовый → синий */
QWidget { background-color: #121722; color: #e6e9ef; }
#sidebarApp { background-color: #0b1020; }
QPushButton {
    background-color: #232a37; color: #e6e9ef;
    border: 1px solid #333c4c; border-radius: 9px; padding: 7px 18px;
}
QPushButton:hover { border-color: #2f86f0; }
QPushButton:disabled { color: #5b6475; }
#view-button-next, #view-button-install {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #28a8a8, stop:1 #2f86f0);
    border: 0; color: #ffffff; font-weight: 600;
}
QLineEdit, QComboBox, QListView, QTreeView {
    background-color: #1a2130; border: 1px solid #2c3546; border-radius: 8px; padding: 5px;
    selection-background-color: #2f86f0;
}
QProgressBar { background-color: #1f2736; border: 0; border-radius: 3px; height: 6px; text-align: center; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #28a8a8, stop:1 #2f86f0); border-radius: 3px; }
